# Composio Research Agent — Environment Variables
# Copy this file to .env and fill in values as needed.

# Optional: API keys for enhanced research capabilities
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# SERP_API_KEY=...

# Optional: GitHub token for higher rate limits
# GITHUB_TOKEN=ghp_...

# Research settings
RESEARCH_CONCURRENCY=5
RESEARCH_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

